# MongoDB connection string
MONGO_URL=mongodb+srv://user:password@cluster.example.mongodb.net/procrasti-not

# Public origin of the app (used for the Logto sign-in/out redirects)
BASE_URL=http://localhost:5173/

# Logto (https://docs.logto.io)
LOGTO_ENDPOINT=https://your-tenant.logto.app/
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_ENCRYPTION_KEY=a-long-random-string

# Gemini (typo correction). Without the key the AI button answers 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional system instruction; both parts are joined with a newline. A default is used when empty.
GEMINI_LEADING_PROMPT=
GEMINI_TRAILING_PROMPT=
